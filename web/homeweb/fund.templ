package homeweb

import (
	"boardfund/service/donations"
	"boardfund/service/enrollments"
	"boardfund/service/fundevents"
	"boardfund/service/members"
	"boardfund/web/common"
	"fmt"
)

// A recurring fund takes subscriptions; a one-off fund takes a single payment.
// Keyed on Recurring rather than on monthly specifically, so a daily fund gets
// the subscription form rather than silently falling through to one-time.
func donationURL(freq donations.PayoutFrequency) string {
	if freq.Recurring() {
		return "/donation/plan"
	}

	return "/donation/once"
}

templ Fund(fund donations.Fund, fundStats donations.FundStats, notes []donations.FundNote, recipients []enrollments.Recipient, image *donations.FundImage, member *members.Member, path string) {
	@common.Layout(member, path) {
		<div id="donation-form" class="p-5 mt-2">
			@FundImagePanel(fund, image)
			<span class="blue-boxy-filter">
				@Title(fund.Name)
				<br/>
				@DonationForm(fund)
			</span>
			<hr class="border-odd "/>
			@Description(fund.Description)
			<hr class="border-odd "/>
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-2">
				@common.FundStatus(fund, fundStats)
				if len(fundStats.Monthly) > 0 {
					<div class="col-span-2 my-2 blue-boxy-filter">
						<div class="text-md font-semibold p-2 inline-block bg-high">month-by-month</div>
						<canvas class="bg-odd">
							@MonthlyTotalsChart(fundStats)
						</canvas>
					</div>
				}
			</div>
			@FundFooter(fund, notes, recipients, member != nil && member.IsAdmin())
		</div>
	}
}

// FundFooter is the bottom of a fund page: who it pays, and what donors said.
//
// Two columns when both are there, because a fund that lists its recipients and
// has notes on it was otherwise two long lists stacked down the page with the
// second one below the fold. One column when there is nothing to put beside the
// notes, rather than a half-width column with a gap next to it.
templ FundFooter(fund donations.Fund, notes []donations.FundNote, recipients []enrollments.Recipient, isAdmin bool) {
	if showRecipients(fund, recipients) {
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
			@RecipientList(fund, recipients)
			@FundNotes(notes, isAdmin)
		</div>
	} else {
		@FundNotes(notes, isAdmin)
	}
}

// RecipientList names the people a fund pays.
//
// Gated here as well as at the handler that decides whether to load them. The
// handler skipping the query is the reason this is usually empty; the check is
// the reason a future caller that loads them anyway still cannot publish a name
// the fund has not agreed to publish.
templ RecipientList(fund donations.Fund, recipients []enrollments.Recipient) {
	if showRecipients(fund, recipients) {
		<div id="fund-recipients" class="mt-6">
			<div class="text-md font-semibold p-2 inline-block bg-high shadow-blue-boxy-thin">who this fund pays</div>
			<ul class="mt-2 bg-odd shadow-blue-boxy">
				for _, recipient := range recipients {
					<li class="px-3 py-2 even:bg-even odd:bg-odd">{ recipient.Name }</li>
				}
			</ul>
		</div>
	}
}

templ DonationForm(fund donations.Fund) {
	<form hx-post={ donationURL(fund.PayoutFrequency) } hx-target="#donation-form" class="bg-even p-4 flex flex-col max-w-md">
		<input type="hidden" name="fund" value={ fund.ID.String() }/>
		<div class="flex flex-wrap items-center gap-2 mb-6">
			<div class="flex items-center gap-2">
				<span>I would like to give</span>
				<div class="inline-flex items-center">
					<span>$</span>
					<input
						type="number"
						min="1"
						name="amount"
						id="amount"
						class="w-24 ml-1 text-sm border-slate-300 shadow-sm"
					/>
				</div>
			</div>
			@Frequency(fund.PayoutFrequency)
		</div>
		<button
			type="submit"
			class="self-center px-6 py-2 bg-button text-black hover:text-black hover:font-medium hover:shadow-blue-boxy-thin shadow-blue-boxy transition-all"
		>
			pay that shit
		</button>
	</form>
}

templ Frequency(freq donations.PayoutFrequency) {
	if freq.Recurring() {
		<div class="flex items-center gap-2">
			<span>every</span>
			<span class="gap-0">
				<select
					name="interval"
					id="interval"
					class="text-sm border-slate-300 shadow-sm"
				>
					<option value="MONTH">month</option>
					<option value="WEEK">week</option>
				</select><span>.</span>
			</span>
		</div>
	} else {
		<div class="flex items-center">
			<span>once.</span>
		</div>
	}
}

templ Description(text string) {
	<div class="w-full my-2 filter blue-boxy-filter">
		<div class="text-md font-semibold p-2 mt-2 inline-block bg-high">about</div>
		<br/>
		<div class="font-medium italic p-2 mb-2 inline-block bg-odd">{ text }</div>
	</div>
}

templ Title(text string) {
	<h2 class="font-semibold bg-high inline-flex text-lg px-2 py-4">donate to&nbsp;<span class="underline underline-offset-4 decoration-[#333333]">{ text }</span></h2>
}

// ClosedFundSummary is the read-only counterpart to Fund: the same statistics
// and the same chart, with the donation form replaced by what the fund did.
// A closed fund still has a story worth reading, and until this existed the only
// way to see it was a page that offered to take money for a fund that had ended.
templ ClosedFundSummary(fund donations.ClosedFund, fundStats donations.FundStats, notes []donations.FundNote, recipients []enrollments.Recipient, image *donations.FundImage, timeline []fundevents.PublicEvent, member *members.Member, path string) {
	@common.Layout(member, path) {
		<div class="p-5 mt-2">
			@FundImagePanel(fund.Fund, image)
			<span class="blue-boxy-filter">
				@Title(fund.Name)
			</span>
			<div class="mt-2 mb-4">
				<span class="text-xs px-2 py-1 bg-gray-200 text-gray-700">
					closed { fund.ClosedOn().Format("January 2, 2006") }
				</span>
			</div>
			<hr class="border-odd"/>
			@Description(fund.Description)
			<hr class="border-odd"/>
			@ClosedFundLedger(fund)
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-2">
				@common.FundStatus(fund.Fund, fundStats)
				if len(fundStats.Monthly) > 0 {
					<div class="col-span-2 my-2 blue-boxy-filter">
						<div class="text-md font-semibold p-2 inline-block bg-high">month-by-month</div>
						<canvas class="bg-odd">
							@MonthlyTotalsChart(fundStats)
						</canvas>
					</div>
				}
			</div>
			@FundTimeline(timeline)
			// Notes outlive the fund. They are part of what it was, and a closed fund
			// is the one people read to decide whether this works. Read-only: nobody
			// can give to it now, so nobody can earn a note on it now -- and a fund
			// ending is not a reason a note that is already up should stay up, so an
			// admin can still take one down.
			//
			// The recipients follow the same setting the fund had while it was open:
			// a closed fund's page should read the way it read to the people who gave
			// to it.
			if showRecipients(fund.Fund, recipients) && len(notes) > 0 {
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
					@RecipientList(fund.Fund, recipients)
					@FundNotes(notes, member != nil && member.IsAdmin())
				</div>
			} else {
				@RecipientList(fund.Fund, recipients)
				if len(notes) > 0 {
					@FundNotes(notes, member != nil && member.IsAdmin())
				}
			}
		</div>
	}
}

// ClosedFundLedger shows both sides at once. Collected on its own says nothing
// about whether the money reached anyone, which is the question a finished fund
// exists to answer.
templ ClosedFundLedger(fund donations.ClosedFund) {
	<div class="my-4 grid grid-cols-2 md:grid-cols-4 gap-4">
		@LedgerFigure("collected", "$"+centsToDecimalString(fund.Stats.TotalDonated))
		@LedgerFigure("paid out", "$"+centsToDecimalString64(fund.Payouts.TotalPaidCents))
		@LedgerFigure("recipients", fmt.Sprintf("%d", fund.Payouts.TotalRecipients))
		@LedgerFigure("payouts", fmt.Sprintf("%d", fund.Payouts.TotalPayouts))
	</div>
	if fund.Undisbursed() != 0 {
		<p class="text-sm text-gray-600 mb-4">
			// Shown rather than hidden. A remainder is usually just what would not
			// divide evenly among recipients, but it is the one figure on this page
			// that could indicate money never went where it was meant to.
			{ "$" + centsToDecimalString64(fund.Undisbursed()) } was collected but not paid out.
		</p>
	}
	if fund.Payouts.LastPayoutDate != nil {
		<p class="text-sm text-gray-600 mb-4">
			last payout { fund.Payouts.LastPayoutDate.Format("January 2, 2006") }.
		</p>
	}
}

templ LedgerFigure(label, value string) {
	<div class="p-3 bg-odd">
		<div class="text-xs text-gray-600">{ label }</div>
		<div class="text-lg font-semibold tabular-nums">{ value }</div>
	</div>
}

// showRecipients is the one place that decides whether a fund's recipients are
// named.
//
// Both conditions, in one function, so the page and the panel cannot disagree
// about it. An empty list is not drawn as an empty box: a fund with the setting
// on and nobody enrolled yet would otherwise show a heading over nothing.
func showRecipients(fund donations.Fund, recipients []enrollments.Recipient) bool {
	return fund.EnrolleesVisible && len(recipients) > 0
}
