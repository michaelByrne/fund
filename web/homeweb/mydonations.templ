package homeweb

import (
	"boardfund/service/donations"
	"boardfund/service/members"
	"boardfund/web/common"
	"fmt"
	"strings"
)

// MyDonations is a donor's own record and the only place they can stop giving.
//
// Its own page rather than a panel on the front page: the front page is for
// finding a fund to support, and a donor comes here to check or change something
// they have already decided.
templ MyDonations(donationsForMember []donations.MemberDonation, member *members.Member, path string) {
	@common.Layout(member, path) {
		<div class="w-[95%] mx-auto mt-4">
			<h2 class="font-semibold text-lg p-2 inline-block bg-high shadow-blue-boxy-thin mx-4">my donations</h2>
			<div id="my-donations" class="ml-4 mb-8 mt-4">
				if len(donationsForMember) == 0 {
					<p class="text-sm p-2">
						you have not donated yet. <a href="/" class="text-links hover:underline">the funds</a> are looking for support.
					</p>
				} else {
					for _, donation := range donationsForMember {
						@MyDonationRow(donation)
					}
				}
			</div>
		</div>
	}
}

// MyDonationRow is also what the cancel button swaps itself for, so the row
// always redraws from what the server did rather than what the click assumed.
templ MyDonationRow(donation donations.MemberDonation) {
	<div id={ "donation-" + donation.ID.String() } class="mb-4 p-4 w-full md:w-[70%] odd:bg-odd even:bg-even shadow-blue-boxy">
		<div class="flex flex-col md:flex-row md:items-baseline">
			<span class="font-semibold text-lg">{ donation.FundName }</span>
			<span class="text-sm md:ml-auto">
				if donation.Active {
					<span class="text-green-700">active</span>
				} else {
					// The reason is the provider's word for it, so a donor who did not
					// cancel can see that something else did.
					<span class="text-gray-500">ended{ endedBecause(donation.InactiveReason) }</span>
				}
			</span>
		</div>
		<div class="text-sm mt-2">
			<p>
				<span class="font-bold">given so far:</span>
				&nbsp;${ centsToDecimalString64(donation.TotalGivenCents) }
			</p>
			if donation.Recurring {
				<p>
					<span class="font-bold">amount:</span>
					&nbsp;${ centsToDecimalString(donation.PlanAmountCents) } every { strings.ToLower(string(donation.PlanIntervalUnit)) }
				</p>
			} else {
				<p><span class="font-bold">one-time donation</span></p>
			}
			<p><span class="font-bold">started:</span> &nbsp;{ donation.Started.Format("01-02-2006") }</p>
			if donation.LastPayment != nil {
				<p><span class="font-bold">last payment:</span> &nbsp;{ donation.LastPayment.Format("01-02-2006") }</p>
			}
		</div>
		if donation.Cancellable() {
			<div class="mt-3">
				<button
					hx-post={ fmt.Sprintf("/donation/cancel/%s", donation.ID.String()) }
					hx-target={ "#donation-" + donation.ID.String() }
					hx-swap="outerHTML"
					hx-confirm={ fmt.Sprintf("stop your recurring donation to %s?", donation.FundName) }
					class="px-3 py-1 text-sm bg-button hover:shadow-blue-boxy-thin shadow-blue-boxy"
				>
					cancel this donation
				</button>
			</div>
		}
	</div>
}

// endedBecause renders the provider's reason where there is one, and nothing
// where there is not: an empty pair of brackets reads worse than no brackets.
func endedBecause(reason string) string {
	if reason == "" {
		return ""
	}

	return " (" + strings.ToLower(reason) + ")"
}
