package homeweb

import (
	"boardfund/service/donations"
	"fmt"
	"github.com/google/uuid"
)

// FundImagePanel is a fund's picture on the fund's own page.
//
// A square, and not a band across the top. Full width at h-48 is roughly six to
// one on a wide screen, and almost nothing is that shape -- a portrait
// photograph lost everything but a strip of its middle, and a logo lost its top
// and bottom. The complaint was the crop, and the crop was the aspect ratio.
//
// object-contain rather than object-cover, so nothing is cropped at all. A square
// crops far more gently than a band did, but "gently" is still deciding which
// part of somebody's picture to throw away, and there is nothing here that knows
// where the subject is. What is uploaded is what appears, letterboxed against the
// same background the page already uses.
//
// Bounded rather than full width, because a full-width square on a desktop is the
// size of the screen.
templ FundImagePanel(fund donations.Fund, image *donations.FundImage) {
	if image != nil {
		<div class="w-48 h-48 md:w-64 md:h-64 bg-even shadow-blue-boxy mb-4 shrink-0">
			<img
				src={ image.URL() }
				alt={ fund.Name }
				width={ fmt.Sprintf("%d", image.Width) }
				height={ fmt.Sprintf("%d", image.Height) }
				loading="lazy"
				class="w-full h-full object-contain"
			/>
		</div>
	}
}

// FundThumbnail is the picture at list size, beside a fund's name in the table.
//
// A fixed box whether or not there is a picture, so the names stay in a column
// rather than stepping in and out depending on which funds have one. object-cover
// because these are whatever shape they were uploaded and a row is not.
//
// Inside the name cell rather than a column of its own: a column needs a heading,
// and there is nothing to call it.
//
// It takes no name. alt is empty on purpose -- the name is the text beside it, in
// the children -- and holding a name it does not use invited the reading that it
// was being used for something.
templ FundThumbnail(image *donations.FundImage) {
	<span class="inline-flex items-center gap-2">
		<span class="shrink-0 w-10 h-10 bg-even inline-block">
			if image != nil {
				<img
					src={ image.URL() }
					alt=""
					width={ fmt.Sprintf("%d", image.Width) }
					height={ fmt.Sprintf("%d", image.Height) }
					loading="lazy"
					class="w-10 h-10 object-cover"
				/>
			}
		</span>
		{ children... }
	</span>
}

// FundCardImage is the picture on the stacked cards the small screens get, where
// there is room for it to be more than a thumbnail.
templ FundCardImage(image *donations.FundImage) {
	if image != nil {
		<img
			src={ image.URL() }
			alt=""
			width={ fmt.Sprintf("%d", image.Width) }
			height={ fmt.Sprintf("%d", image.Height) }
			loading="lazy"
			class="w-full h-32 object-cover mb-3"
		/>
	}
}

// imageFor is the picture for a fund, or nil. A helper rather than a comma-ok in
// the template, because templ cannot bind the second return value.
func imageFor(images map[uuid.UUID]donations.FundImage, fundID uuid.UUID) *donations.FundImage {
	image, ok := images[fundID]
	if !ok {
		return nil
	}

	return &image
}
