package homeweb

import (
	"boardfund/service/donations"
	"fmt"
	"github.com/google/uuid"
)

// FundImageBanner is a fund's picture, above what the fund is for.
//
// A fixed height with object-fit: cover, so one upload works at any shape without
// the page jumping between funds. A portrait photograph and a wide banner both
// fill the same band; what varies is how much of them is shown, not where
// everything below them sits.
//
// width and height are given so the browser reserves the space before the bytes
// arrive, rather than reflowing the description out from under a reader.
//
// The alt text is the fund's name because that is what the picture is of, as far
// as anything here knows. There is no caption field and inventing one from the
// filename would describe an upload rather than an image.
templ FundImageBanner(fund donations.Fund, image *donations.FundImage) {
	if image != nil {
		<img
			src={ image.URL() }
			alt={ fund.Name }
			width={ fmt.Sprintf("%d", image.Width) }
			height={ fmt.Sprintf("%d", image.Height) }
			loading="lazy"
			class="w-full h-48 md:h-64 object-cover bg-even shadow-blue-boxy mb-4"
		/>
	}
}

// FundThumbnail is the picture at list size, beside a fund's name in the table.
//
// A fixed box whether or not there is a picture, so the names stay in a column
// rather than stepping in and out depending on which funds have one. object-cover
// because these are whatever shape they were uploaded and a row is not.
//
// Inside the name cell rather than a column of its own: a column needs a heading,
// and there is nothing to call it.
templ FundThumbnail(image *donations.FundImage, name string) {
	<span class="inline-flex items-center gap-2">
		<span class="shrink-0 w-10 h-10 bg-even inline-block">
			if image != nil {
				<img
					src={ image.URL() }
					alt=""
					width={ fmt.Sprintf("%d", image.Width) }
					height={ fmt.Sprintf("%d", image.Height) }
					loading="lazy"
					class="w-10 h-10 object-cover"
				/>
			}
		</span>
		{ children... }
	</span>
}

// FundCardImage is the picture on the stacked cards the small screens get, where
// there is room for it to be more than a thumbnail.
templ FundCardImage(image *donations.FundImage) {
	if image != nil {
		<img
			src={ image.URL() }
			alt=""
			width={ fmt.Sprintf("%d", image.Width) }
			height={ fmt.Sprintf("%d", image.Height) }
			loading="lazy"
			class="w-full h-32 object-cover mb-3"
		/>
	}
}

// imageFor is the picture for a fund, or nil. A helper rather than a comma-ok in
// the template, because templ cannot bind the second return value.
func imageFor(images map[uuid.UUID]donations.FundImage, fundID uuid.UUID) *donations.FundImage {
	image, ok := images[fundID]
	if !ok {
		return nil
	}

	return &image
}
