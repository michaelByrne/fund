package homeweb

import (
	"boardfund/service/donations"
	"boardfund/service/notices"
	"boardfund/service/members"
	"boardfund/web/common"
	"fmt"
	"github.com/google/uuid"
	"strconv"
	"strings"
	"time"
)

templ FundsTitle() {
	<h2 class="font-semibold text-lg p-2 inline-block bg-high shadow-blue-boxy-thin mt-4 mx-4">current active funds</h2>
}

templ Funds(funds []donations.Fund, closed []donations.ClosedFund, images map[uuid.UUID]donations.FundImage, notices []notices.Notice, member *members.Member, path string) {
	@common.Layout(member, path) {
		<div id="funds">
			<div class="w-[95%] mx-auto">
				@NoticeCard(notices)
				@FundsTitle()
				<div class="ml-4 mb-5 mt-4 bl">
					<div class="hidden lg:table max-h-[300px] w-[90%] overflow-y-auto">
						<table class="table-auto w-full border-collapse text-sm leading-relaxed blue-boxy-filter">
							<thead class="bg-even">
								<tr>
									<th class="p-2 text-left font-semibold w-[30%]">name</th>
									<th class="p-2 text-left font-semibold w-[10%]">donors</th>
									<th class="p-2 text-left font-semibold w-[10%]">donated</th>
									<th class="p-2 text-left font-semibold w-[10%]">goal</th>
									<th class="p-2 text-left font-semibold w-[10%]">frequency</th>
									<th class="p-2 text-left font-semibold w-[15%]">expires</th>
								</tr>
							</thead>
							<tbody>
								for _, fund := range funds {
									// The name is a real link and its ::after overlay covers the row, so
									// the whole row stays clickable with one tab stop, a working
									// middle-click and a URL the browser can show. See RowLink.
									<tr class="clickable relative odd:bg-odd odd:hover:bg-odd-hover even:bg-even even:hover:bg-even-hover">
										<td class="p-2">
											@FundThumbnail(imageFor(images, fund.ID)) {
												@RowLink(fmt.Sprintf("/donate/%s", fund.ID.String()), fund.Name)
											}
										</td>
										<td class="p-2">{ fmt.Sprintf("%d", fund.Stats.TotalDonors) }</td>
										<td class="p-2">${ centsToDecimalString(fund.Stats.TotalDonated) }</td>
										@TableGoal(fund.GoalCents)
										<td class="p-2">{ string(fund.PayoutFrequency) }</td>
										@TableExpires(fund.Expires)
									</tr>
								}
							</tbody>
						</table>
					</div>
					<div class="block lg:hidden space-y-4 text-sm">
						for _, fund := range funds {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/donate/%s", fund.ID.String())) }
								class="block mb-4 p-4 odd:bg-odd even:bg-even hover:shadow-blue-boxy-thin shadow-blue-boxy"
							>
								@FundCardImage(imageFor(images, fund.ID))
								<p class="font-semibold text-lg mb-2">{ fund.Name }</p>
								<div>
									<p><span class="font-bold">donors:</span> { fmt.Sprintf("%d", fund.Stats.TotalDonors) }</p>
									<p><span class="font-bold">donated:</span> ${ centsToDecimalString(fund.Stats.TotalDonated) }</p>
									<p>
										<span class="font-bold">goal:</span> @TableGoal(fund.GoalCents)
									</p>
									<p><span class="font-bold">frequency:</span> { string(fund.PayoutFrequency) }</p>
									<p>
										<span class="font-bold">expires:</span> @TableExpires(fund.Expires)
									</p>
								</div>
							</a>
						}
					</div>
				</div>
				@ClosedFunds(closed, images)
			</div>
		</div>
	}
}

// ClosedFunds is the archive under the active list. Rendered as nothing at all
// when empty rather than as an empty table with a heading, which on a new
// instance would read as a fault.
templ ClosedFunds(funds []donations.ClosedFund, images map[uuid.UUID]donations.FundImage) {
	if len(funds) > 0 {
		<h2 class="font-semibold text-lg p-2 inline-block bg-high shadow-blue-boxy-thin mt-8 mx-4">closed funds</h2>
		<div class="ml-4 mb-5 mt-4 bl">
			<div class="hidden lg:table max-h-[300px] w-[90%] overflow-y-auto">
				<table class="table-auto w-full border-collapse text-sm leading-relaxed blue-boxy-filter">
					<thead class="bg-even">
						<tr>
							<th class="p-2 text-left font-semibold w-[30%]">name</th>
							<th class="p-2 text-left font-semibold w-[10%]">donors</th>
							<th class="p-2 text-left font-semibold w-[12%]">collected</th>
							<th class="p-2 text-left font-semibold w-[12%]">paid out</th>
							<th class="p-2 text-left font-semibold w-[12%]">recipients</th>
							<th class="p-2 text-left font-semibold w-[15%]">closed</th>
						</tr>
					</thead>
					<tbody>
						for _, fund := range funds {
							<tr class="clickable relative odd:bg-odd odd:hover:bg-odd-hover even:bg-even even:hover:bg-even-hover">
								<td class="p-2">
									@FundThumbnail(imageFor(images, fund.ID)) {
										@RowLink(fmt.Sprintf("/fund/%s/summary", fund.ID.String()), fund.Name)
									}
								</td>
								<td class="p-2">{ fmt.Sprintf("%d", fund.Stats.TotalDonors) }</td>
								<td class="p-2 tabular-nums">${ centsToDecimalString(fund.Stats.TotalDonated) }</td>
								<td class="p-2 tabular-nums">${ centsToDecimalString64(fund.Payouts.TotalPaidCents) }</td>
								<td class="p-2 tabular-nums">{ fmt.Sprintf("%d", fund.Payouts.TotalRecipients) }</td>
								<td class="p-2">{ fund.ClosedOn().Format("01-02-2006") }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="block lg:hidden space-y-4 text-sm">
				for _, fund := range funds {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/fund/%s/summary", fund.ID.String())) }
						class="block mb-4 p-4 odd:bg-odd even:bg-even hover:shadow-blue-boxy-thin shadow-blue-boxy"
					>
						@FundCardImage(imageFor(images, fund.ID))
						<p class="font-semibold text-lg mb-2">{ fund.Name }</p>
						<div>
							<p><span class="font-bold">collected:</span> ${ centsToDecimalString(fund.Stats.TotalDonated) }</p>
							<p><span class="font-bold">paid out:</span> ${ centsToDecimalString64(fund.Payouts.TotalPaidCents) }</p>
							<p><span class="font-bold">recipients:</span> { fmt.Sprintf("%d", fund.Payouts.TotalRecipients) }</p>
							<p><span class="font-bold">closed:</span> { fund.ClosedOn().Format("01-02-2006") }</p>
						</div>
					</a>
				}
			</div>
		</div>
	}
}

// RowLink makes a whole table row clickable without giving up on being a link.
//
// An anchor cannot wrap a <tr>, and one anchor per cell would put six identical
// tab stops and six identical announcements in every row. So the name cell holds
// the only anchor, and that anchor's ::after is stretched to cover the row. The
// row is positioned `relative`, which is what the overlay sizes itself against;
// without it the overlay would spread to the whole page.
//
// The result is one tab stop and one accessible name per row, plus everything
// hx-get could never do: middle-click, open in a new tab, copy link address, and
// a destination the browser shows before you commit to it.
templ RowLink(href, label string) {
	<a
		href={ templ.SafeURL(href) }
		class="after:absolute after:inset-0 after:content-[''] hover:underline"
	>
		{ label }
	</a>
}

templ TableNextPayment(nextPayment time.Time) {
	if nextPayment.Before(time.Now()) {
		&nbsp;paid
	} else {
		&nbsp;{ nextPayment.Format("01-02-2006") }
	}
}

templ TableExpires(expires *time.Time) {
	if expires == nil {
		<td>&nbsp;&#8734;</td>
	} else {
		<td>&nbsp;{ expires.Format("01-02-2006") }</td>
	}
}

templ TableGoal(goal int32) {
	if goal == 0 {
		<td>&nbsp;&#8734;</td>
	} else {
		<td>&nbsp;${ centsToDecimalString(goal) }</td>
	}
}

templ About(member *members.Member, path string) {
	@common.Layout(member, path) {
		<div class="mx-auto mt-2 p-4 pb-6">
			@common.SectionTitle("about")
			<p class="mt-2">BCO Mutual Aid is a platform for community support in the form of bucks.</p>
		</div>
	}
}

func centsToDecimalString(cents int32) string {
	x := float64(cents) / 100

	s := fmt.Sprintf("%.2f", x)

	parts := strings.Split(s, ".")
	integerPart := parts[0]
	decimalPart := parts[1]

	n := len(integerPart)
	if n > 3 {
		var result strings.Builder
		for i, digit := range integerPart {
			if (n-i)%3 == 0 && i != 0 {
				result.WriteString(",")
			}
			result.WriteRune(digit)
		}
		integerPart = result.String()
	}

	return integerPart + "." + decimalPart
}

// centsToDecimalString64 formats a bigint total. Payout sums come back as int64
// because a fund's lifetime disbursement is not bounded by the int32 that holds
// a single donation, so narrowing here would silently wrap the one number this
// exists to display.
//
// Integer division rather than float64: past 2^53 cents a float loses whole
// cents, and a total that reads $0.01 short is worse than one that is merely
// large.
func centsToDecimalString64(cents int64) string {
	sign := ""
	if cents < 0 {
		sign = "-"
		cents = -cents
	}

	whole := cents / 100
	frac := cents % 100

	return sign + addThousandsSeparators(strconv.FormatInt(whole, 10)) + fmt.Sprintf(".%02d", frac)
}

func addThousandsSeparators(digits string) string {
	n := len(digits)
	if n <= 3 {
		return digits
	}

	var result strings.Builder
	for i, digit := range digits {
		if (n-i)%3 == 0 && i != 0 {
			result.WriteString(",")
		}

		result.WriteRune(digit)
	}

	return result.String()
}

// NoticeCard is what the admins have to say, above the funds.
//
// Omitted entirely when there is nothing, rather than shown empty. This sits at
// the top of the first page every member sees, and an empty box there is a
// permanent piece of furniture that says nothing -- which is also how a reader
// learns to stop looking at it.
templ NoticeCard(notices []notices.Notice) {
	if len(notices) > 0 {
		<div class="mt-4 mx-4">
			<div class="text-md font-semibold p-2 inline-block bg-high shadow-blue-boxy-thin">notices</div>
			<div class="mt-2 space-y-2 md:w-[90%]">
				for _, notice := range notices {
					<div class="p-3 bg-even shadow-blue-boxy">
						// Escaped like every other member-facing string. An admin typing
						// a link gets the text of one, which is the trade made when these
						// were specified as plain text.
						<p class="text-sm whitespace-pre-wrap break-words">{ notice.Body }</p>
						<p class="text-xs text-gray-600 mt-2 tabular-nums">{ notice.Created.Format("January 2, 2006") }</p>
					</div>
				}
			</div>
		</div>
	}
}
