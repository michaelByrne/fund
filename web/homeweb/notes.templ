package homeweb

import (
	"boardfund/service/donations"
	"fmt"
	"strconv"
)

// FundNotes is what donors have said about a fund.
//
// Its own full-width section below the status and chart, rather than a column
// inside that grid. Notes vary in number and length, so a fixed column would
// either clip them or leave a hole -- and the grid already changes shape
// depending on whether the fund has a chart to show. The page reads give, what it
// is for, how it is going, what people said.
templ FundNotes(fund donations.Fund, notes []donations.FundNote, own *donations.FundNote, canWrite, isAdmin bool) {
	<div id="fund-notes" class="mt-6">
		<div class="text-md font-semibold p-2 inline-block bg-high">notes from donors</div>
		if canWrite {
			@FundNoteForm(fund, own, "")
		}
		if len(notes) == 0 {
			<p class="text-sm p-2">
				if canWrite {
					nobody has left a note yet.
				} else {
					no notes yet.
				}
			</p>
		} else {
			<div class="mt-2 space-y-3 md:w-[70%]">
				for _, note := range notes {
					<div id={ "note-" + note.ID.String() } class="p-3 bg-even">
						<p class="text-sm whitespace-pre-wrap">{ note.Body }</p>
						<p class="text-xs text-gray-600 mt-2">
							if note.Anonymous {
								// No name reaches the template for an anonymous note, so
								// there is nothing here to leak by accident.
								anonymous
							} else {
								{ note.AuthorName }
							}
							&nbsp;&middot;&nbsp;{ note.Created.Format("01-02-2006") }
							if note.Edited() {
								&nbsp;&middot;&nbsp;edited
							}
							if isAdmin {
								// Where the note is, rather than on a separate moderation
								// page: somebody removing one is reading it at the time. The
								// route is behind the admin middleware, so the button being
								// absent is a courtesy and not the control.
								<button
									hx-post={ fmt.Sprintf("/admin/note/remove/%s", note.ID.String()) }
									hx-target={ "#note-" + note.ID.String() }
									hx-swap="outerHTML"
									hx-confirm="remove this note?"
									class="ml-2 text-red-700 hover:underline"
								>
									remove
								</button>
							}
						</p>
					</div>
				}
			</div>
		}
	</div>
}

// FundNoteForm is also what the save swaps itself for, so the section redraws
// from what the server stored rather than from what was typed.
templ FundNoteForm(fund donations.Fund, own *donations.FundNote, failure string) {
	<form
		id="fund-note-form"
		hx-post={ fmt.Sprintf("/fund/%s/note", fund.ID.String()) }
		hx-target="#fund-notes"
		hx-target-error="#fund-note-form"
		hx-swap="outerHTML"
		class="mt-2 p-3 bg-odd md:w-[70%] flex flex-col"
	>
		if failure != "" {
			<p class="mb-2 p-2 text-sm bg-odd-hover">{ failure }</p>
		}
		<label for="note-body" class="text-sm mb-1">
			if own != nil {
				your note
			} else {
				leave a note
			}
		</label>
		<textarea
			id="note-body"
			name="body"
			rows="3"
			maxlength={ strconv.Itoa(donations.MaxNoteLength) }
			class="text-sm p-2 border border-slate-300 shadow-sm"
			placeholder="why this fund matters to you"
		>
			if own != nil {
				{ own.Body }
			}
		</textarea>
		<div class="flex items-center gap-3 mt-2">
			<label class="text-xs flex items-center gap-1">
				if own != nil && own.Anonymous {
					<input type="checkbox" name="anonymous" value="true" checked/>
				} else {
					<input type="checkbox" name="anonymous" value="true"/>
				}
				post without my name
			</label>
			<button
				type="submit"
				class="ml-auto px-4 py-1 text-sm bg-button hover:shadow-blue-boxy-thin shadow-blue-boxy"
			>
				if own != nil {
					update note
				} else {
					leave note
				}
			</button>
		</div>
	</form>
}
