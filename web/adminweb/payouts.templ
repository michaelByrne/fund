package adminweb

import (
	"boardfund/service/members"
	"boardfund/service/payouts"
	"boardfund/web/common"
	"fmt"
	"time"
)

templ Payouts(batches []payouts.BatchDetail, member *members.Member, path string) {
	@Admin(member, path) {
		<div class="grid grid-cols-1 gap-6 overflow-visible">
			<div class="flex flex-col overflow-visible">
				@AwaitingApproval(batches)
			</div>
		</div>
	}
}

// AwaitingApproval does not box its list into a scroll of its own.
//
// The payee panels are positioned against the row they belong to, and an
// overflow-y-auto ancestor clips anything positioned inside it -- the panel would
// be cut off at the edge of the box, or hidden entirely for the last row. The page
// scrolls instead, which is one scrollbar rather than two.
templ AwaitingApproval(batches []payouts.BatchDetail) {
	@common.Section("batches awaiting approval") {
		<div class="flex-grow">
			<ul id="batches">
				@BatchList(batches)
			</ul>
		</div>
	}
}

templ BatchList(batches []payouts.BatchDetail) {
	if len(batches) == 0 {
		<li class="p-2 text-gray-600">nothing awaiting approval</li>
	} else {
		for _, batch := range batches {
			@BatchRow(batch)
		}
	}
}

// BatchRow is one batch awaiting a decision.
//
// The fund is named, because "$40.00, 4 payees" does not say which fund is about
// to send money -- and on a page listing several batches, that was the whole
// question. The payees are named on hover, because who is being paid is the other
// half of it and there is no room to list four names in a row.
templ BatchRow(batch payouts.BatchDetail) {
	<li
		id={ "batch-" + batch.ID.String() }
		class="batch-row p-2 flex flex-col even:bg-even odd:bg-odd odd:hover:bg-odd-hover even:hover:bg-even-hover transition-opacity duration-300"
	>
		<div class="flex flex-col w-full md:flex-row md:items-center">
			<div class="w-full md:w-48 font-medium">
				<a href={ templ.SafeURL("/admin/payout/" + batch.ID.String()) } class="hover:underline">
					{ payoutAmount(batch.AmountCents) }
				</a>
			</div>
			<div class="w-full md:w-48 truncate" title={ batch.FundName }>{ batch.FundName }</div>
			<div class="w-full md:w-32">
				@PayeeCount(batch)
			</div>
			<div class="w-full md:w-48">{ batch.PayoutDate.Format("01-02-2006") }</div>
			<div class="w-full md:flex-1">
				@ApprovalDeadline(batch.Batch)
			</div>
		</div>
		<div id={ "batch-actions-" + batch.ID.String() } class="mt-2">
			@BatchActions(batch.Batch)
		</div>
	</li>
}

// PayeeCount is how many are being paid, and on hover, who.
//
// A panel positioned against the count rather than the browser's own popover. A
// popover renders in the top layer, which is what stopped it being clipped -- and
// also what put it in the middle of the screen, because placing one beside its
// button needs CSS anchor positioning and that is Chrome only. Beside the words it
// belongs to beats escaping a clip that this page no longer does.
//
// Hover, and focus. group-focus-within is what makes this reachable by keyboard
// and on a touch screen, where there is no hover at all and a tap is a focus.
templ PayeeCount(batch payouts.BatchDetail) {
	if len(batch.PayeeNames) == 0 {
		<span class="text-gray-600">{ fmt.Sprintf("%d payees", batch.NumEnrollments) }</span>
	} else {
		<span class="group relative inline-block">
			<button
				type="button"
				class="underline decoration-dotted underline-offset-2 hover:text-blue-500"
			>
				{ fmt.Sprintf("%d payees", batch.NumEnrollments) }
			</button>
			<span
				class="hidden group-hover:block group-focus-within:block absolute left-0 top-full mt-1 z-50
					w-56 p-3 text-left bg-contrast border border-slate-300 shadow-blue-boxy"
			>
				<span class="block text-xs font-semibold mb-1">
					{ batch.FundName } &middot; { payoutAmount(batch.AmountCents) }
				</span>
				// Scrolls rather than truncating. A batch can pay everybody enrolled in
				// a fund, and "and 25 more" is the answer only when there is nowhere to
				// put them.
				<span class="block text-sm max-h-64 overflow-y-auto">
					for _, name := range batch.PayeeNames {
						<span class="block py-0.5">{ name }</span>
					}
				</span>
			</span>
		</span>
	}
}

// ApprovalDeadline is the one thing a treasurer needs at a glance: an expired batch
// cannot be approved, only re-planned, so the remaining time is what decides whether
// to act now.
templ ApprovalDeadline(batch payouts.Batch) {
	if batch.ApprovalDeadline == nil {
		<span class="text-xs text-gray-600">no deadline</span>
	} else if batch.ApprovalExpired(time.Now()) {
		<span class="text-xs font-semibold text-red-700">expired { batch.ApprovalDeadline.Format("01-02 15:04") }</span>
	} else {
		<span class="text-xs">
			{ fmt.Sprintf("%s left", remaining(*batch.ApprovalDeadline)) }
			<span class="text-gray-600">({ batch.ApprovalDeadline.Format("01-02 15:04") })</span>
		</span>
	}
}

templ BatchActions(batch payouts.Batch) {
	if batch.Status == payouts.StatusAwaitingApproval && !batch.ApprovalExpired(time.Now()) {
		<div class="flex flex-row gap-2 items-center">
			<button
				class="bg-high px-3 py-1 text-xs font-semibold shadow-blue-boxy-thin hover:bg-odd-hover"
				hx-post={ "/admin/payout/approve/" + batch.ID.String() }
				hx-target={ "#batch-actions-" + batch.ID.String() }
				hx-swap="innerHTML"
				hx-confirm={ fmt.Sprintf("Approve %s to %d payees? This clears it for submission.", payoutAmount(batch.AmountCents), batch.NumEnrollments) }
			>
				approve
			</button>
			<button
				class="bg-even px-3 py-1 text-xs shadow-blue-boxy-thin hover:bg-even-hover"
				hx-post={ "/admin/payout/reject/" + batch.ID.String() }
				hx-target={ "#batch-actions-" + batch.ID.String() }
				hx-swap="innerHTML"
				hx-confirm="Reject this batch? It cannot be approved afterwards."
			>
				reject
			</button>
		</div>
	} else {
		@BatchStatus(batch)
	}
}

templ BatchStatus(batch payouts.Batch) {
	<div class="flex flex-row gap-4 items-center text-xs">
		<span class="font-semibold">{ string(batch.Status) }</span>
		if batch.ApprovedAt != nil {
			<span class="text-gray-600">approved { batch.ApprovedAt.Format("01-02 15:04") }</span>
		}
		if batch.FailureReason != "" {
			<span class="text-gray-600">{ batch.FailureReason }</span>
		}
	</div>
}

templ PayoutDetail(batch payouts.Batch, items []payouts.Payout, member *members.Member, path string) {
	@Admin(member, path) {
		<div class="grid grid-cols-1 gap-6 overflow-visible">
			<div class="flex flex-col overflow-visible">
				@BatchSummary(batch)
			</div>
			<div class="flex flex-col overflow-visible">
				@BatchItems(items)
			</div>
		</div>
	}
}

templ BatchSummary(batch payouts.Batch) {
	@common.Section("batch") {
		<div class="flex flex-col gap-1">
			@detailRow("amount", payoutAmount(batch.AmountCents)+fmt.Sprintf(" across %d payees", batch.NumEnrollments))
			@detailRow("status", string(batch.Status))
			@detailRow("payout date", batch.PayoutDate.Format("01-02-2006"))
			if batch.ApprovalDeadline != nil {
				<div class="flex flex-row">
					<div class="w-48 text-gray-600">approval deadline</div>
					<div>
						@ApprovalDeadline(batch)
					</div>
				</div>
			}
			if batch.ApprovedBy != nil && batch.ApprovedAt != nil {
				@detailRow("approved", batch.ApprovedAt.Format("01-02-2006 15:04")+" by "+batch.ApprovedBy.String())
			}
			if batch.ProviderBatchID != "" {
				@detailRow("provider batch", batch.ProviderBatchID)
			}
			if batch.FailureReason != "" {
				@detailRow("failure reason", batch.FailureReason)
			}
		</div>
		<div id={ "batch-actions-" + batch.ID.String() } class="mt-4">
			@BatchActions(batch)
		</div>
	}
}

templ BatchItems(items []payouts.Payout) {
	@common.Section("payouts") {
		<div class="flex-grow overflow-y-auto max-h-[300px] sm:max-h-[500px]">
			<ul>
				for _, item := range items {
					<li class="p-2 flex flex-col md:flex-row md:items-center even:bg-even odd:bg-odd">
						<div class="w-full md:w-32 font-medium">{ payoutAmount(item.AmountCents) }</div>
						<div class="w-full md:w-32">{ string(item.Status) }</div>
						<div class="w-full md:flex-1 break-all">{ item.DestinationEmail }</div>
						if item.ProviderFeeCents != 0 {
							<div class="w-full md:w-24 text-xs text-gray-600">
								{ fmt.Sprintf("fee %s", payoutAmount(item.ProviderFeeCents)) }
							</div>
						}
					</li>
				}
			</ul>
		</div>
	}
}

templ detailRow(label, value string) {
	<div class="flex flex-row">
		<div class="w-48 text-gray-600">{ label }</div>
		<div class="break-all">{ value }</div>
	</div>
}
