package adminweb

import (
	"strings"

	"boardfund/service/adminevents"
	"boardfund/service/members"
	"boardfund/web/common"
)

// AdminAudit is the log of who granted and revoked admin access.
//
// Admin is Cognito group membership and nothing else, so this list is the record
// of every change to the authorisation model. It is read-only by construction:
// there is no update or delete query behind it, and nothing here offers one.
templ AdminAudit(events []adminevents.Event, member *members.Member, path string) {
	@Admin(member, path) {
		<div class="w-[95%] mx-auto mt-4 mb-8">
			@common.Section("access changes") {
				if len(events) == 0 {
					// An empty log is the ordinary state of a new deployment, and it is
					// worth saying which one this is: nothing has happened, rather than
					// nothing is being recorded.
					<p class="text-sm p-2">
						no access has been granted or revoked since this log was added.
						changes made directly in cognito do not appear here.
					</p>
				} else {
					<div class="overflow-x-auto">
						<table class="table-auto w-full border-collapse text-sm leading-relaxed">
							<thead class="bg-even">
								<tr>
									<th class="p-2 text-left font-semibold">when</th>
									<th class="p-2 text-left font-semibold">what</th>
									<th class="p-2 text-left font-semibold">member</th>
									<th class="p-2 text-left font-semibold">by</th>
								</tr>
							</thead>
							<tbody>
								for _, event := range events {
									<tr class="odd:bg-odd even:bg-even">
										<td class="p-2 whitespace-nowrap">{ event.OccurredAt.Format("01-02-2006 15:04") }</td>
										<td class="p-2">
											<span class="font-semibold">{ adminEventLabel(event.Kind) }</span>
										</td>
										<td class="p-2">
											if event.AboutAMember() {
												<a href={ templ.SafeURL("/admin/member/" + event.SubjectMemberID.String()) } class="text-links hover:underline">
													{ event.Subject() }
												</a>
											} else {
												// An approved email address has no member page to link
												// to, which is the whole reason it was approved: nobody
												// can register until somebody does this.
												{ event.Subject() }
											}
										</td>
										<td class="p-2">
											if event.ByProvider() {
												// Not the same as "nobody did it". A change made in the
												// cognito console, or before this log existed, has no
												// member to name, and guessing one would be a lie in the
												// only place that exists to be trusted.
												<span class="text-gray-500 italic">not recorded</span>
											} else if event.SelfInflicted() {
												<span class="font-semibold">{ event.ActorName } (themselves)</span>
											} else {
												<a href={ templ.SafeURL("/admin/member/" + event.ActorMemberID.String()) } class="text-links hover:underline">
													{ event.ActorName }
												</a>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				<p class="text-xs text-gray-500 p-2">
					append-only. nothing in the application can edit or remove a line here.
				</p>
			}
		</div>
	}
}

// adminEventLabel is what a row says happened.
//
// Not derived from Granted(), which only says which direction the change went:
// two kinds grant and two revoke, and "granted admin" on an approved email
// address would be wrong in the one place that exists to be trusted.
func adminEventLabel(kind adminevents.Kind) string {
	switch kind {
	case adminevents.KindAdminGranted:
		return "granted admin"
	case adminevents.KindAdminRevoked:
		return "revoked admin"
	case adminevents.KindEmailApproved:
		return "approved to register"
	case adminevents.KindEmailApprovalRemoved:
		return "registration approval removed"
	default:
		// A kind added to the enum and not to this switch still reads as
		// something rather than as a blank cell.
		return strings.ReplaceAll(string(kind), "_", " ")
	}
}
