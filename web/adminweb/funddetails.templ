package adminweb

import (
	"boardfund/service/donations"
	"boardfund/web/common"
	"fmt"
	"time"
)

// FundDetails is what a fund is, and the only place any of it can be changed.
//
// The picture used to be a control of its own at the bottom of this page, which
// made the most visible thing about a fund the one thing you set from a box
// nowhere near anything else about it. It is a setting, so it lives with the
// settings.
//
// Name and frequency are not here. Both are held by PayPal as well as by us --
// the name is the product name and the descriptor a donor sees on their card
// statement, and the frequency decides which plan a subscription is bound to.
// Changing either here would write a value we hold and PayPal does not, which is
// worse than not offering it.
templ FundDetails(fund donations.Fund, image *donations.FundImage, failure, success string) {
	<div id="fund-details">
		@common.Section("fund details") {
			if failure != "" {
				<p class="mb-2 p-2 text-sm bg-odd-hover">{ failure }</p>
			}
			if success != "" {
				<p class="mb-2 p-2 text-sm bg-high">{ success }</p>
			}
			<div class="flex flex-col md:flex-row gap-4">
				<div class="shrink-0">
					@FundImageControl(fund.ID, image, "")
				</div>
				<form
					hx-post={ fmt.Sprintf("/admin/fund/details/%s", fund.ID.String()) }
					hx-target="#fund-details"
					hx-target-error="#fund-details"
					hx-swap="outerHTML"
					class="flex-grow grid grid-cols-3 gap-3 text-sm"
				>
					<label for="fund-description" class="col-span-1">description</label>
					<textarea
						name="description"
						id="fund-description"
						rows="3"
						class="col-span-2 w-full pl-1 text-sm border border-slate-300 shadow-sm"
					>{ fund.Description }</textarea>
					<label for="fund-goal" class="col-span-1">goal</label>
					<div class="col-span-2 relative">
						<span class="absolute left-1 top-1/2 transform -translate-y-1/2 text-gray-500">$</span>
						<input
							type="number"
							name="goal"
							id="fund-goal"
							min="0"
							step="0.01"
							placeholder="optional"
							value={ goalValue(fund.GoalCents) }
							class="w-full pl-6 text-sm border border-slate-300 shadow-sm"
						/>
					</div>
					<label for="fund-expires" class="col-span-1">end date</label>
					<input
						type="date"
						name="date"
						id="fund-expires"
						value={ expiresValue(fund.Expires) }
						class="col-span-2 w-full pl-1 text-sm border border-slate-300 shadow-sm"
					/>
					<p class="col-span-3 text-xs text-gray-600">
						{ fund.Name } is { string(fund.PayoutFrequency) }. neither can be changed here:
						paypal holds both, and this would only change our copy.
					</p>
					<div class="col-span-3 flex">
						<button
							type="submit"
							class="ml-auto px-3 py-1 text-sm bg-button hover:shadow-blue-boxy-thin shadow-blue-boxy"
						>
							save
						</button>
					</div>
				</form>
			</div>
		}
	</div>
}

// goalValue is the goal as a form field takes it, and empty when there is none --
// a goal of zero and no goal at all are the same thing to a fund, and "0" in the
// box reads as a decision somebody made.
func goalValue(cents int32) string {
	if cents == 0 {
		return ""
	}

	return centsToDecimalString(cents)
}

// expiresValue is the end date as a date input takes it, and empty when the fund
// does not end.
//
// Formatted in UTC because that is how it was parsed -- a date box gives a day,
// and time.Parse reads it as midnight UTC. Rendering it in local time hands back
// the day before anywhere west of Greenwich, so opening the form and saving it
// again would walk the date backwards one day at a time.
func expiresValue(expires *time.Time) string {
	if expires == nil {
		return ""
	}

	return expires.UTC().Format("2006-01-02")
}
