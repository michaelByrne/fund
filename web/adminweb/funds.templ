package adminweb

import (
	"boardfund/service/donations"
	"boardfund/service/finance"
	"boardfund/service/members"
	"fmt"
	"github.com/google/uuid"
	"time"
)

templ Funds(funds []donations.Fund, member *members.Member, path string) {
	@Admin(member, path) {
		<div class="grid grid-cols-1 md:grid-cols-2 h-[90vh] overflow-hidden">
			<div>
				@AddFund()
			</div>
			<div class="overflow-auto">
				@FundsList(funds)
			</div>
		</div>
	}
}

templ AddFund() {
	<div class="w-full mx-auto max-w-md blue-boxy-filter">
		<h3 class="text-md font-semibold mt-2 inline-block bg-high p-2">new fund</h3>
		// hx-encoding, because a file cannot travel in a urlencoded body -- without
		// it htmx sends the filename and nothing else, and the server sees an empty
		// upload.
		//
		// The form empties itself once the fund exists, so the next one starts from
		// nothing rather than from the last one's name and description -- which is
		// how somebody ends up creating "human fund" twice. Only on success: a
		// refusal replaces this form with itself carrying the message, and clearing
		// the boxes would take the values from the person about to correct them.
		<form
			hx-post="/admin/fund"
			hx-swap="afterbegin"
			hx-target="#admin-funds"
			hx-target-error="this"
			hx-encoding="multipart/form-data"
			hx-on::after-request="if (event.detail.successful) this.reset()"
			class="w-[90%] p-4 bg-even"
		>
			<div class="grid grid-cols-3 gap-4 mt-6">
				<label for="name" class="col-span-1 text-left">name</label>
				<input type="text" placeholder="human fund" required name="name" id="name" class="col-span-2 w-full pl-1 text-sm border border-slate-300 shadow-sm"/>
				<label for="description" class="col-span-1 text-left">description</label>
				<textarea name="description" placeholder="what's it for?" id="description" class="col-span-2 w-full pl-1 text-sm border border-slate-300 shadow-sm"></textarea>
				<label for="goal" class="col-span-1 text-left">goal</label>
				<div class="col-span-2 relative">
					<span class="absolute left-1 top-1/2 transform -translate-y-1/2 text-gray-500">$</span>
					<input
						type="number"
						name="goal"
						placeholder="optional"
						id="goal"
						min="0"
						class="w-full pl-6 text-sm border border-slate-300 shadow-sm"
					/>
				</div>
				<label for="frequency" class="col-span-1 text-left">frequency</label>
				<select name="frequency" id="frequency" class="col-span-2 w-full pl-1 text-sm border border-slate-300 shadow-sm">
					<option value="monthly">monthly</option>
					<option value="once">once</option>
					<option value="daily">daily</option>
				</select>
				<label for="date" class="col-span-1 text-left">end date</label>
				<input type="date" name="date" id="date" class="col-span-2 w-full pl-1 text-sm border border-slate-300 shadow-sm"/>
				// A one-off fund pays out on its end date, so without one it would
				// collect donations and never pay any of them out. Said here as well as
				// refused by the service, because being told after filling the form in
				// is a worse way to learn it.
				<span class="col-span-3 text-xs text-gray-600">
					a fund that pays out once needs an end date -- that is the day it pays.
				</span>
				// Here rather than only on the fund's own page. The picture is the
				// largest thing about a fund on the site now -- the front page draws it
				// beside the name -- so it belongs where the fund is described, not as
				// something to remember afterwards.
				<label for="fund-picture" class="col-span-1 text-left">picture</label>
				<div class="col-span-2">
					<input
						type="file"
						name="image"
						id="fund-picture"
						accept="image/jpeg,image/png,image/webp"
						class="w-full text-xs"
					/>
					<p class="mt-1 text-xs text-gray-600">optional. jpeg, png or webp.</p>
				</div>
			</div>
			<div class="mt-6 flex justify-center">
				<button
					type="submit"
					class="px-4 py-2 text-center text-md bg-button text-black hover:text-black hover:font-medium hover:shadow-blue-boxy-thin shadow-blue-boxy"
				>
					submit
				</button>
			</div>
			// Where a partial success lands. The response to this form is a row for a
			// different part of the page, so anything to say about the fund itself has
			// to be swapped out of band into somewhere that already exists.
			<div id="fund-create-notice"></div>
		</form>
	</div>
}

// FundsList is every fund, in two lists.
//
// One list headed "current funds" held both, which made the heading wrong about
// half its contents. They stay on this tab -- a fund vanishing the day it expired
// took its payouts and payees out of reach on the day a treasurer would look for
// them -- but under a heading that says what they are.
//
// Closed ones are absent rather than an empty list with a heading, which on a new
// instance would read as a fault.
templ FundsList(funds []donations.Fund) {
	<div id="funds-list" class="w-full mx-auto max-w-md h-full blue-boxy-filter">
		<h3 class="text-md font-semibold mt-2 bg-high inline-block p-2">current funds</h3>
		// The new-fund form prepends here, so this list holds the open ones: a fund
		// is never created closed.
		<ul id="admin-funds" class="max-w-[90%] max-h-[300px]">
			for _, fund := range openFunds(funds) {
				@FundRow(fund)
			}
		</ul>
		if len(closedFunds(funds)) > 0 {
			<h3 class="text-md font-semibold mt-6 bg-high inline-block p-2">closed funds</h3>
			<ul id="admin-closed-funds" class="max-w-[90%] max-h-[300px]">
				for _, fund := range closedFunds(funds) {
					@FundRow(fund)
				}
			</ul>
		}
	</div>
}

// openFunds and closedFunds split the one list the handler passes. Split here
// rather than in the handler because it is a question about how this page reads,
// and Closed() already answers it -- deactivated, or past its end date.
func openFunds(funds []donations.Fund) []donations.Fund {
	var open []donations.Fund

	for _, fund := range funds {
		if !fund.Closed() {
			open = append(open, fund)
		}
	}

	return open
}

func closedFunds(funds []donations.Fund) []donations.Fund {
	var closed []donations.Fund

	for _, fund := range funds {
		if fund.Closed() {
			closed = append(closed, fund)
		}
	}

	return closed
}

templ FundRow(fund donations.Fund) {
	<li
		class="clickable fund-row p-2 flex flex-col md:flex-row md:items-center gap-2 odd:bg-odd even:bg-even odd:hover:bg-odd-hover even:hover:bg-even-hover relative"
		hx-get={ fmt.Sprintf("/admin/fund?fund=%s", fund.ID.String()) }
	>
		<div class="flex items-center w-full">
			<div class="flex flex-col w-full md:flex-row md:items-center md:gap-2 min-w-0">
				<span class={ "font-medium truncate", templ.KV("text-gray-500", fund.Closed()) }>{ fund.Name }</span>
				@FundState(fund)
				<span class="text-sm text-gray-600 md:ml-auto shrink-0">{ string(fund.PayoutFrequency) }</span>
			</div>
			// A link rather than an icon opening a dropdown. The dropdown listed the
			// stored reports a fund had, and there are no stored reports now -- one
			// live view per fund, so there is nothing to choose between. It was also
			// swapping a whole page into a list inside itself.
			//
			// stopPropagation because the row carries its own hx-get to the fund
			// page, and a click here would otherwise trigger both.
			//
			// text-blue-500 rather than text-links. --color-links is #333 on this
			// theme, which is what body text already is, so the only thing marking
			// this as a link was the pointer cursor -- and the whole row has one.
			<a
				href={ templ.SafeURL(fmt.Sprintf("/admin/fund/audit?fund=%s", fund.ID.String())) }
				onclick="event.stopPropagation()"
				title="payments checked against PayPal"
				class="ml-4 shrink-0 text-sm text-blue-500 hover:underline whitespace-nowrap"
			>
				view audit
			</a>
			if !fund.Closed() {
				<div
					hx-post={ fmt.Sprintf("/admin/fund/deactivate/%s", fund.ID.String()) }
					hx-confirm={ fmt.Sprintf("deactivate %s?", fund.Name) }
					hx-trigger="click consume"
					hx-swap="outerHTML"
					class="text-title/90 hover:text-red-500 text-lg font-bold ml-4"
				>
					&#215;
				</div>
			}
		</div>
		<script type="application/javascript">
            me().on("fundDeactivated", (ev) => {
                ev.srcElement.closest('.fund-row').fadeOut(null, 400);
            });
        </script>
	</li>
}

templ FundPaymentsAudit(audit finance.Audit, member *members.Member, path string) {
	@Admin(member, path) {
		<div class="p-2">
			<h3 class="text-md font-semibold bg-high inline-block p-2 blue-boxy-filter">
				payments <span class="font-medium">for</span> { audit.FundName }
			</h3>
			// Outside the filtered box. blue-boxy-filter is a drop-shadow, which
			// shadows the shape of everything inside it -- fine for a heading or a
			// table, which have backgrounds and cast a box, and wrong for bare text,
			// which casts a copy of itself four pixels down and reads as doubled.
			<p class="text-xs text-gray-600 pt-3 pb-2 max-w-2xl">
				checked against PayPal nightly. anything taken since the last run reads as unchecked.
			</p>
			if len(audit.Payments) == 0 {
				<p class="text-sm py-2">this fund has taken no payments.</p>
			} else {
				<div class="hidden md:block blue-boxy-filter">
					<div class="max-h-[400px] overflow-auto">
						<table class="w-full text-xs text-left border-collapse leading-relaxed bg-back">
							<thead class="sticky top-0 z-10 bg-even">
								<tr>
									<th class="text-left w-[2%]"><span class="inline-block p-2"></span></th>
									<th class="text-left w-[10%]"><span class="inline-block p-2">date</span></th>
									<th class="text-left w-[14%]"><span class="inline-block p-2">donor</span></th>
									<th class="text-left w-[20%] hide-on-small"><span class="inline-block p-2">paypal id</span></th>
									<th class="text-left w-[10%]"><span class="inline-block p-2">amount</span></th>
									<th class="text-left w-[12%]"><span class="inline-block p-2">paypal amount</span></th>
									<th class="text-left w-[10%] hide-on-small"><span class="inline-block p-2">fee</span></th>
									<th class="text-left w-[16%]"><span class="inline-block p-2">checked</span></th>
								</tr>
							</thead>
							<tbody>
								for _, payment := range audit.Payments {
									<tr class="even:bg-even odd:bg-odd">
										@VerdictCell(payment)
										<td class="pl-2">{ payment.Created.Format("01-02-2006") }</td>
										<td>{ payment.DonorName }</td>
										<td class="font-mono hide-on-small">{ transactionID(payment.ProviderPaymentID) }</td>
										<td>
											${ centsToDecimalString(payment.AmountCents) }
											if payment.RefundedCents > 0 {
												// Refunded money is not money the fund holds, and the amount
												// column alone would say it is.
												<span class="text-red-700">&nbsp;-${ centsToDecimalString(payment.RefundedCents) }</span>
											}
										</td>
										<td>{ transactionAmount(payment.ProviderAmountCents) }</td>
										<td class="hide-on-small">${ centsToDecimalString(payment.FeeAmountCents) }</td>
										<td>{ string(payment.Verdict()) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
				<div class="md:hidden">
					<div class="space-y-4">
						for _, payment := range audit.Payments {
							<div class="bg-white p-4">
								<div class="flex items-center justify-between mb-2">
									<div class="flex items-center space-x-2">
										@VerdictBadge(payment)
										<span class="text-sm font-medium">{ payment.Created.Format("01-02-2006") }</span>
									</div>
									<span class="text-sm font-bold">${ centsToDecimalString(payment.AmountCents) }</span>
								</div>
								<div class="space-y-2 text-xs">
									<div class="flex justify-between">
										<span class="text-gray-500">donor:</span>
										<span>{ payment.DonorName }</span>
									</div>
									<div class="flex justify-between">
										<span class="text-gray-500">paypal id:</span>
										<span class="font-mono">{ transactionID(payment.ProviderPaymentID) }</span>
									</div>
									<div class="flex justify-between">
										<span class="text-gray-500">paypal amount:</span>
										<span>{ transactionAmount(payment.ProviderAmountCents) }</span>
									</div>
									if payment.RefundedCents > 0 {
										<div class="flex justify-between">
											<span class="text-gray-500">refunded:</span>
											<span class="text-red-700">${ centsToDecimalString(payment.RefundedCents) }</span>
										</div>
									}
									<div class="flex justify-between">
										<span class="text-gray-500">checked:</span>
										<span>{ string(payment.Verdict()) }</span>
									</div>
								</div>
							</div>
						}
					</div>
				</div>
			}
		</div>
	}
}

// VerdictCell marks the rows worth looking at.
//
// Three states, not two. The old cell compared our amount to the provider's and
// showed a red warning whenever they differed -- which for a payment nobody had
// reconciled yet meant comparing against zero, so every recent payment was
// flagged as a problem. A page where everything is red says nothing.
templ VerdictCell(payment finance.AuditPayment) {
	if payment.NeedsAttention() {
		<td class="px-1 justify-center bg-red-300 flex items-center" title={ string(payment.Verdict()) }>!</td>
	} else if payment.Verdict() == finance.AuditOK {
		<td class="px-1 justify-center bg-green-200 flex items-center" title="agrees with paypal">&check;</td>
	} else {
		// Not yet checked, or too recent for PayPal's reporting to know about.
		// Neither is a fault, and neither is a clean bill of health.
		<td class="px-1 justify-center bg-gray-200 flex items-center" title={ string(payment.Verdict()) }>&ndash;</td>
	}
}

templ VerdictBadge(payment finance.AuditPayment) {
	if payment.NeedsAttention() {
		<span class="px-1 bg-red-300">!</span>
	} else if payment.Verdict() == finance.AuditOK {
		<span class="px-1 bg-green-200">&check;</span>
	} else {
		<span class="px-1 bg-gray-200">&ndash;</span>
	}
}

func transactionDate(date time.Time) string {
	if date.IsZero() {
		return "?"
	}
	return date.Format("01-02-2006")
}

func transactionID(transactionID string) string {
	if transactionID == "" {
		return "?"
	}
	return transactionID
}

func transactionAmount(amount int32) string {
	if amount == 0 {
		return "?"
	}

	return "$" + centsToDecimalString(amount)
}

func transactionStatus(status string) string {
	if status == "" {
		return "?"
	}
	return status
}

func convertToLastDayOfMonth(dateString string) string {
	parsedTime, err := time.Parse("2006-01", dateString)
	if err != nil {
		return "date error"
	}

	lastDay := parsedTime.AddDate(0, 1, 0).AddDate(0, 0, -1)

	formattedDate := lastDay.Format("01-02-2006")

	return formattedDate
}

func makeAuditURL(fundID uuid.UUID, date time.Time, auditType string) string {
	urlOut := "/admin/fund/audit"
	urlOut += "?fund=" + fundID.String()
	urlOut += "&date=" + date.Format("01-02-2006")
	urlOut += "&type=" + auditType

	return urlOut
}

// FundState labels a fund that no longer takes donations. Expiry and
// deactivation are shown separately: one happened on its own, the other is
// something a person did, and a treasurer looking at a fund that stopped
// collecting needs to know which.
templ FundState(fund donations.Fund) {
	if !fund.Active {
		<span class="text-xs px-1 bg-gray-200 text-gray-700 shrink-0">closed</span>
	} else if fund.Expired() {
		<span class="text-xs px-1 bg-gray-200 text-gray-700 shrink-0">expired</span>
	}
}

// FundCreatedWithoutPicture is the fund's row plus a word about the picture that
// did not make it.
//
// The row is what the form's target expects, so the new fund still appears in the
// list. The message is swapped out of band into the form, because the fund was
// created and telling somebody otherwise would send them to make a second one.
templ FundCreatedWithoutPicture(fund donations.Fund, failure string) {
	@FundRow(fund)
	<div id="fund-create-notice" hx-swap-oob="true" class="mt-4 p-2 text-sm bg-odd-hover">
		{ fund.Name } was created, but the picture was not: { failure }
		<br/>
		add one from the fund's page.
	</div>
}
